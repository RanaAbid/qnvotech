# Copy secrets to `.env.local` (local) or cPanel Node.js env (production).
# Non-secret defaults live in committed `.env` so local and production stay aligned.

# --- Non-secret defaults (also set in `.env`) ---
NEXT_PUBLIC_SITE_URL=https://qnvotech.com
CONTACT_EMAIL=info@qnvotech.com
RESEND_FROM_EMAIL=QNVO Technologies <noreply@qnvotech.com>
NEXT_PUBLIC_GTM_ID=GTM-MZHN4NQS
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KC8ERNZR58

# --- Optional / secrets (do not commit real values) ---
# Set to 1 only if you intentionally want zero Google tags on the site.
# NEXT_PUBLIC_ANALYTICS_DISABLED=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Optional shared rate-limit store. Without it, the contact limit is per server instance.
# UPSTASH_REDIS_REST_URL must be https and *.upstash.io
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notes:
# - Do not put secrets in NEXT_PUBLIC_ values.
# - Do not set a personal mailbox. Public inbox is info@qnvotech.com.
# - NEXT_PUBLIC_SENTRY_DSN is intentionally unused so a DSN is not shipped to the browser.
# - Production requires TURNSTILE_SECRET_KEY — contact API fails closed without it.
# - Production Origin checks use NEXT_PUBLIC_SITE_URL only (not X-Forwarded-Host).
# - Analytics: GTM + GA4 ship with code defaults even if env IDs are blank at build.
#   Empty NEXT_PUBLIC_GTM_ID / NEXT_PUBLIC_GA_MEASUREMENT_ID in cPanel still fall back to
#   GTM-MZHN4NQS / G-KC8ERNZR58. Use NEXT_PUBLIC_ANALYTICS_DISABLED=1 to turn tags off.
