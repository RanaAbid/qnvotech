# Non-secret defaults for local and production.
# Loaded by Next.js at build and start (both `next dev` and `next start`).
# Secrets (Turnstile, Resend, Sentry, Upstash, Sanity tokens) go in:
#   - local: .env.local (gitignored)
#   - production: cPanel > Setup Node.js App > Environment variables

NEXT_PUBLIC_SITE_URL=https://qnvotech.com
CONTACT_EMAIL=info@qnvotech.com
RESEND_FROM_EMAIL=QNVO Technologies <noreply@qnvotech.com>
NEXT_PUBLIC_GTM_ID=GTM-MZHN4NQS
